# 로컬 개발용. 이 파일을 .env.local로 복사해 쓴다. VITE_* 값은 번들에 공개되므로 비밀값을 넣지 않는다.

# 토스페이먼츠 테스트 클라이언트 키(test_ck_…). 공개 값이라 번들에 들어가도 된다. 비워 두면 HP 충전 버튼이 꺼진다.
# dev·운영 이미지는 GitHub Variable TOSS_PAYMENTS_CLIENT_KEY를 빌드 인자로 받는다(docs/deploy.md).
VITE_TOSS_PAYMENTS_CLIENT_KEY=

# 개발 서버(pnpm dev)가 /api를 넘길 로컬 Envoy 주소(BE docker/compose.yaml의 envoy, ENVOY_PORT로 포트를 바꿨으면 맞춘다).
# VITE_ 접두사가 없어 번들에 들어가지 않는다. 비워 두면 http://localhost:8000.
API_PROXY_TARGET=
