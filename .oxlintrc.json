{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*"],
                "message": "import는 app → pages → features → entities → shared 한 방향이에요. pages에서 app을 가져오지 않아요."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*", "@/pages", "@/pages/*"],
                "message": "features는 entities·shared만 가져와요."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app",
                  "@/app/*",
                  "@/pages",
                  "@/pages/*",
                  "@/features",
                  "@/features/*"
                ],
                "message": "entities는 shared만 가져와요. 다른 entity가 필요하면 그 조합은 features나 pages에서 해요."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app",
                  "@/app/*",
                  "@/pages",
                  "@/pages/*",
                  "@/features",
                  "@/features/*",
                  "@/entities",
                  "@/entities/*"
                ],
                "message": "shared는 합방 도메인을 몰라요. 다른 층을 가져오지 않아요."
              }
            ]
          }
        ]
      }
    }
  ]
}
